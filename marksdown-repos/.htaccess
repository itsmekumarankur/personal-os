Options -Indexes
RewriteEngine On

# Route .md browser requests through the markdown viewer
# Skip if ?raw=1 is present (used by md.html's internal fetch)
RewriteCond %{QUERY_STRING} !raw=1
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+\.md)$ /marksdown-repos/md.html?file=%{REQUEST_URI} [L,QSA]
