calAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="732" width="80" height="30" as="geometry"/></mxCell><mxCell id="b75" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="732" width="80" height="30" as="geometry"/></mxCell><mxCell id="b76" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="732" width="80" height="30" as="geometry"/></mxCell><mxCell id="b77" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1580" y="732" width="80" height="30" as="geometry"/></mxCell><mxCell id="b78" value="&lt;b&gt;R4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="762" width="50" height="30" as="geometry"/></mxCell><mxCell id="b79" value="+ re-ranker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="762" width="430" height="30" as="geometry"/></mxCell><mxCell id="b80" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="762" width="80" height="30" as="geometry"/></mxCell><mxCell id="b81" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="762" width="80" height="30" as="geometry"/></mxCell><mxCell id="b82" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="762" width="80" height="30" as="geometry"/></mxCell><mxCell id="b83" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1580" y="762" width="80" height="30" as="geometry"/></mxCell><mxCell id="b84" value="&lt;b&gt;R5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="792" width="50" height="30" as="geometry"/></mxCell><mxCell id="b85" value="+ Neo4j neighbours" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="910" y="792" width="430" height="30" as="geometry"/></mxCell><mxCell id="b86" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1340" y="792" width="80" height="30" as="geometry"/></mxCell><mxCell id="b87" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1420" y="792" width="80" height="30" as="geometry"/></mxCell><mxCell id="b88" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="792" width="80" height="30" as="geometry"/></mxCell><mxCell id="b89" value="-" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1580" y="792" width="80" height="30" as="geometry"/></mxCell><mxCell id="b90" value="The “-” cells are empty on purpose: no run has happened yet. Fill them from real runs. Do not trust anyone’s numbers (including mine) for your own code." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="832" width="800" height="70" as="geometry"/></mxCell><mxCell id="b91" value="&lt;b&gt;Rules so the test stays honest&lt;/b&gt;&lt;br&gt;• Decide in advance what counts as “better” (for example +3 points of recall@5) and that no kind of question may get worse.&lt;br&gt;• Keep 8 questions as a hold-out set that you look at only at the end, so you do not tune to the test.&lt;br&gt;• With 33 questions, one question is 3 points. Differences of 1 or 2 questions are noise. Grow the set to 100 over time.&lt;br&gt;• Run the whole ladder again whenever the embedding model, the chunker or the reranker changes." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="780" height="215" as="geometry"/></mxCell><mxCell id="b92" value="&lt;b&gt;Done when&lt;/b&gt;&lt;br&gt;• The 33-question set exists, checked in to the repo, pinned to a commit.&lt;br&gt;• One command prints recall@5, recall@10, MRR, p50 latency and cost per query for R0 to R5.&lt;br&gt;• You can say, with numbers, which change helped most and which did nothing.&lt;br&gt;• All 3 forbidden questions return zero forbidden chunks.&lt;br&gt;• A pull request that lowers recall@5 below the agreed limit fails CI." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="1045" width="800" height="215" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="8. Decisions and risks"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="999" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="Architect’s notes: why these choices, what they cost, and what can break" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#111827;fontSize=24;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1620" height="40" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;Decision&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="260" height="30" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Why&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="400" height="30" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;Cost or risk&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="560" height="30" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;Other choice&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="70" width="400" height="30" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Elasticsearch for search&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="47" as="geometry"/></mxCell><mxCell id="b7" value="Words + meaning + permission filter in one query." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="400" height="47" as="geometry"/></mxCell><mxCell id="b8" value="More memory for vectors. Example: 1,000,000 chunks × 1,024 numbers × 4 bytes ≈ 4 GB before index overhead. Quantising cuts it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="560" height="47" as="geometry"/></mxCell><mxCell id="b9" value="Postgres + pgvector (simpler, smaller scale)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="100" width="400" height="47" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Neo4j for relations&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="147" width="260" height="47" as="geometry"/></mxCell><mxCell id="b11" value="“Who calls this?” and “which test covers this?” are graph questions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="147" width="400" height="47" as="geometry"/></mxCell><mxCell id="b12" value="A third system. Only sees calls the parser can see. Calls through reflection, dependency injection or HTTP between services are missed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="147" width="560" height="47" as="geometry"/></mxCell><mxCell id="b13" value="Store caller/callee ids as a field in Elasticsearch (a cheap start)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="147" width="400" height="47" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;MongoDB as notebook only&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="260" height="47" as="geometry"/></mxCell><mxCell id="b15" value="Tracks fingerprints and status. Easy to ask “what still uses the old model?”." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="194" width="400" height="47" as="geometry"/></mxCell><mxCell id="b16" value="A third place that can drift from the other two. The reconciler is mandatory." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="194" width="560" height="47" as="geometry"/></mxCell><mxCell id="b17" value="A table in Postgres, or an index inside Elasticsearch." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="194" width="400" height="47" as="geometry"/></mxCell><mxCell id="b18" value="&lt;b&gt;AST (tree-sitter) chunking&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="241" width="260" height="47" as="geometry"/></mxCell><mxCell id="b19" value="Cuts at real code boundaries in many languages with one library." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="241" width="400" height="47" as="geometry"/></mxCell><mxCell id="b20" value="One grammar per language. Odd or broken files need the fallback window." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="241" width="560" height="47" as="geometry"/></mxCell><mxCell id="b21" value="Fixed windows: simple, but cuts methods in half." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="241" width="400" height="47" as="geometry"/></mxCell><mxCell id="b22" value="&lt;b&gt;Accessors folded into class card&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="260" height="47" as="geometry"/></mxCell><mxCell id="b23" value="Removes noise, keeps “shape” questions answerable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="288" width="400" height="47" as="geometry"/></mxCell><mxCell id="b24" value="A getter with real logic could be mis-detected. Test it with the 4 shape questions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="288" width="560" height="47" as="geometry"/></mxCell><mxCell id="b25" value="Index every accessor (more noise)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="288" width="400" height="47" as="geometry"/></mxCell><mxCell id="b26" value="&lt;b&gt;RRF in our code&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="260" height="30" as="geometry"/></mxCell><mxCell id="b27" value="Works regardless of licence or version." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="335" width="400" height="30" as="geometry"/></mxCell><mxCell id="b28" value="We maintain 15 lines of code." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="335" width="560" height="30" as="geometry"/></mxCell><mxCell id="b29" value="Elasticsearch’s built-in RRF." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="335" width="400" height="30" as="geometry"/></mxCell><mxCell id="b30" value="&lt;b&gt;Blue/green index for model changes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="260" height="47" as="geometry"/></mxCell><mxCell id="b31" value="No mixed vectors, instant rollback." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="365" width="400" height="47" as="geometry"/></mxCell><mxCell id="b32" value="Double storage for a few days." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="365" width="560" height="47" as="geometry"/></mxCell><mxCell id="b33" value="Edit in place (never recommended)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="365" width="400" height="47" as="geometry"/></mxCell><mxCell id="b34" value="What can break, how we notice, how we fix it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#111827;fontSize=15;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="437" width="1000" height="28" as="geometry"/></mxCell><mxCell id="b35" value="&lt;b&gt;Problem&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="472" width="360" height="30" as="geometry"/></mxCell><mxCell id="b36" value="&lt;b&gt;How we notice&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="472" width="480" height="30" as="geometry"/></mxCell><mxCell id="b37" value="&lt;b&gt;What we do&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="472" width="780" height="30" as="geometry"/></mxCell><mxCell id="b38" value="&lt;b&gt;The three stores disagree&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="360" height="30" as="geometry"/></mxCell><mxCell id="b39" value="The nightly reconciler counts differ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="502" width="480" height="30" as="geometry"/></mxCell><mxCell id="b40" value="Re-run that repo. Chunks stuck at ‘pending’ are simply redone." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="502" width="780" height="30" as="geometry"/></mxCell><mxCell id="b41" value="&lt;b&gt;A code formatter touches every file&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="532" width="360" height="47" as="geometry"/></mxCell><mxCell id="b42" value="Many files “changed”, a big re-embedding bill." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="532" width="480" height="47" as="geometry"/></mxCell><mxCell id="b43" value="Fingerprint ignores spaces and line endings, so formatting-only changes cost nothing. Lines moving is a metadata-only update." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="532" width="780" height="47" as="geometry"/></mxCell><mxCell id="b44" value="&lt;b&gt;First index of a huge repo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="579" width="360" height="30" as="geometry"/></mxCell><mxCell id="b45" value="Hours long, rate-limit errors from the embedding API." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="579" width="480" height="30" as="geometry"/></mxCell><mxCell id="b46" value="Batches, a rate limiter, and resume from the notebook’s status." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="579" width="780" height="30" as="geometry"/></mxCell><mxCell id="b47" value="&lt;b&gt;Generated or vendor code floods the index&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="609" width="360" height="30" as="geometry"/></mxCell><mxCell id="b48" value="Search results full of code nobody wrote." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="609" width="480" height="30" as="geometry"/></mxCell><mxCell id="b49" value="Skip list plus a per-repo ignore file. Check the share of chunks per folder after each run." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="609" width="780" height="30" as="geometry"/></mxCell><mxCell id="b50" value="&lt;b&gt;Embedding model is retired or changed&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="639" width="360" height="30" as="geometry"/></mxCell><mxCell id="b51" value="Provider notice, or the test set drops after a swap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="639" width="480" height="30" as="geometry"/></mxCell><mxCell id="b52" value="Blue/green re-index (page 4)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="639" width="780" height="30" as="geometry"/></mxCell><mxCell id="b53" value="&lt;b&gt;Someone loses access to a repo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="669" width="360" height="30" as="geometry"/></mxCell><mxCell id="b54" value="Access reviews, the forbidden test questions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="669" width="480" height="30" as="geometry"/></mxCell><mxCell id="b55" value="ACL sync every few minutes, metadata-only update, live check for sensitive repos." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="669" width="780" height="30" as="geometry"/></mxCell><mxCell id="b56" value="&lt;b&gt;Neo4j is stale for one file&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="699" width="360" height="30" as="geometry"/></mxCell><mxCell id="b57" value="Missing neighbours, odd graph." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="699" width="480" height="30" as="geometry"/></mxCell><mxCell id="b58" value="Delete that file’s nodes and arrows, then MERGE again from the new parse." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="699" width="780" height="30" as="geometry"/></mxCell><mxCell id="b59" value="&lt;b&gt;Poisoned comment or README&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="729" width="360" height="30" as="geometry"/></mxCell><mxCell id="b60" value="Flagged chunks, strange answers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="729" width="480" height="30" as="geometry"/></mxCell><mxCell id="b61" value="Data-not-instructions rule, no tools in the answer step, review flagged chunks." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="729" width="780" height="30" as="geometry"/></mxCell><mxCell id="b62" value="&lt;b&gt;What is NOT done yet (honest list)&lt;/b&gt;&lt;br&gt;This is a design on paper: no code has been written or run for Project 11, so no scores exist. All sizes and limits are starting values. Licences and clustering for Elasticsearch, Neo4j and MongoDB need checking before production. Cross-service calls (HTTP between services) and framework magic (dependency injection) are not seen by the map. Next step: build the pipeline in the order of the ladder on page 7, and fill the numbers." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#111827;fontSize=14;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;spacingBottom=4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="789" width="1620" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>